                local hrp = enemy.Character:FindFirstChild("HumanoidRootPart")
                if hrp and isInFov(hrp.Position) and tick() - fovLastShot >= fovCooldown then
                    shootEnemy(enemy)
                    fovLastShot = tick()
                    break
                end
            end
        end
    end
end)

