-- 9.4: رمي السكين التلقائي
getgenv().autoThrowEnabled = false
getgenv().throwDistance = 300
getgenv().throwCooldown = 2
local autoThrowThread = nil
local lastThrowTime = 0

local function performThrow(targetChar)
    local tool = Player.Character:FindFirstChildOfClass("Tool")
    if not tool or not tool:FindFirstChild("RightHandle") then return end
    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHrp then return end
    local origin = getCharacterOrigin(Player.Character)
    local direction = (targetHrp.Position - origin).Unit
    ReplicatedStorage.Remotes.ThrowStart:FireServer(origin, direction)
    require(ReplicatedStorage.Modules.KnifeProjectileController)({
        Speed = tool:GetAttribute("ThrowSpeed"),
        KnifeProjectile = tool.RightHandle:Clone(),
        Direction = direction,
        Origin = origin
    }, function(res)
        ReplicatedStorage.Remotes.ThrowHit:FireServer(res and res.Instance, res and res.Position)
    end)
    lastThrowTime = tick()
end

MainTab:Toggle({
    Title = "رمي السكين تلقائياً",
    Desc = "يرمي السكين على الأعداء",
    Default = false,
    Callback = function(Value)
        getgenv().autoThrowEnabled = Value
        if autoThrowThread then task.cancel(autoThrowThread); autoThrowThread = nil end
        if Value then
            autoThrowThread = task.spawn(function()
                while getgenv().autoThrowEnabled do
                    if (tick() - lastThrowTime) >= getgenv().throwCooldown then
                        local myChar = Player.Character
                        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        if myRoot then
                            local closest = nil
                            local shortest = getgenv().throwDistance
                            for _, p in ipairs(MatchModule.EnemiesList) do
                                if p ~= Player and p.Character and p.Team ~= Player.Team then
                                    local eHrp = p.Character:FindFirstChild("HumanoidRootPart")
                                    local eHum = p.Character:FindFirstChild("Humanoid")
                                    if eHrp and eHum and eHum.Health > 0 then
                                        local dist = (eHrp.Position - myRoot.Position).Magnitude
                                        local params = RaycastParams.new()
                                        params.FilterDescendantsInstances = { myChar, p.Character }
                                        params.FilterType = Enum.RaycastFilterType.Exclude
                                        local result = workspace:Raycast(myRoot.Position, (eHrp.Position - myRoot.Position), params)
                                        if dist < shortest and not result then
                                            shortest = dist; closest = p.Character
                                        end
                                    end
                                end
                            end
                            if closest then performThrow(closest) end
                        end
                    end
                    task.wait(0.1)
                end
            end)
        end
    end
})
MainTab:Slider({ Title = "أقصى مسافة للرمي", Value = { Min = 0, Max = 1000, Default = 300 }, Callback = function(v) getgenv().throwDistance = v end })
MainTab:Slider({ Title = "فترة التهدئة للرمي", Value = { Min = 0.5, Max = 10, Default = 2 }, Callback = function(v) getgenv().throwCooldown = v end })
