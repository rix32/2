-- 9.3: التصوير التلقائي
getgenv().autoShootEnabled = false
getgenv().maxShootDist = 300
getgenv().shootCooldown = 2
local autoShootThread = nil

MainTab:Toggle({
    Title = "التصوير التلقائي",
    Desc = "إطلاق النار تلقائياً على الأعداء",
    Icon = "check",
    Default = false,
    Flag = "AutoShootToggle",
    Callback = function(Value)
        getgenv().autoShootEnabled = Value
        featureToggleNotify(Value)
        if autoShootThread then task.cancel(autoShootThread); autoShootThread = nil end
        if Value then
            local function hasClearLOS(from, to, myChar, targetChar)
                local params = RaycastParams.new()
                params.FilterDescendantsInstances = { myChar, targetChar }
                params.FilterType = Enum.RaycastFilterType.Exclude
                local result = workspace:Raycast(from, (to - from), params)
                if result and not result.Instance:IsDescendantOf(targetChar) then return false end
                return true
            end
            autoShootThread = task.spawn(function()
                while getgenv().autoShootEnabled do
                    local myChar = Player.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local myHum = myChar and myChar:FindFirstChild("Humanoid")
                    if MatchModule.isActive and myRoot and myHum and myHum.Health > 0 then
                        local closest = nil
                        local closestDist = getgenv().maxShootDist or 1000
                        for _, enemy in ipairs(MatchModule.EnemiesList) do
                            local char = enemy.Character
                            local hrp = char and char:FindFirstChild("HumanoidRootPart")
                            local hum = char and char:FindFirstChild("Humanoid")
                            if enemy ~= Player and hum and hum.Health > 0 and hrp then
                                local dist = (hrp.Position - myRoot.Position).Magnitude
                                if dist < closestDist then
                                    local onDiffTeam = (not enemy.Team or enemy.Team ~= Player.Team)
                                    local inFOV = (Camera.CFrame.LookVector:Dot((hrp.Position - Camera.CFrame.Position).Unit) >= 0.9)
                                    if onDiffTeam and inFOV then
                                        closestDist = dist; closest = enemy
                                    end
                                end
                            end
                        end
                        if closest and canShoot then
                            local tChar = closest.Character
                            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
                            if tHrp and hasClearLOS(myRoot.Position, tHrp.Position, myChar, tChar) then
                                shootEnemy(closest)
                            end
                        end
                    end
                    task.wait(0.03)
                end
            end)
        end
    end
})

