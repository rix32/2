local FovTab = MainWindow:Tab({ Title = "حقل الرؤية (FOV)", Icon = "crosshair", Locked = false })
local fovEnabled = false
local fovAuto = false
local fovManual = false
local fovRadius = 100
local fovCooldown = 1
local fovLastShot = 0
local fovCircle = nil

local function createFovCircle()
    if fovCircle then fovCircle:Remove() end
    fovCircle = Drawing.new("Circle")
    fovCircle.Thickness = 2
    fovCircle.NumSides = 64
    fovCircle.Radius = fovRadius
    fovCircle.Color = Color3.fromRGB(255, 255, 255)
    fovCircle.Transparency = 1
    fovCircle.Visible = false
    fovCircle.Filled = false
end
createFovCircle()

local function updateFovCircle()
    if fovCircle and (fovEnabled or fovAuto or fovManual) then
        local mousePos = UserInputService:GetMouseLocation()
        fovCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
        fovCircle.Radius = fovRadius
        fovCircle.Visible = true
    elseif fovCircle then
        fovCircle.Visible = false
    end
end

local function isInFov(targetPos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
    if not onScreen then return false end
    local mousePos = UserInputService:GetMouseLocation()
    return math.sqrt((screenPos.X - mousePos.X)^2 + (screenPos.Y - mousePos.Y)^2) <= fovRadius
end

RunService.Heartbeat:Connect(function()
    updateFovCircle()
    if not fovAuto then return end
    local myChar = Player.Character
    if not myChar then return end
    for _, enemy in pairs(Players:GetPlayers()) do
        if enemy ~= Player and enemy.Team ~= Player.Team and enemy.Character then
            local hrp = enemy.Character:FindFirstChild("HumanoidRootPart")
            if hrp and isInFov(hrp.Position) then
                local params = RaycastParams.new()
                params.FilterDescendantsInstances = { myChar, enemy.Character }
                params.FilterType = Enum.RaycastFilterType.Exclude
                local res = workspace:Raycast(myChar.HumanoidRootPart.Position, (hrp.Position - myChar.HumanoidRootPart.Position), params)
                if not res and tick() - fovLastShot >= fovCooldown then
                    shootEnemy(enemy)
                    fovLastShot = tick()
                    break
                end
            end
        end
    end
end)

