local function walkToPad(model)
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if hum and root and model and model.PrimaryPart then
        local targetPos = model.PrimaryPart.Position
        local dist = (root.Position - targetPos).Magnitude
        if dist <= 6 then
            getgenv().noclip = false
            for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = true end end
            return
        end
        hum.WalkSpeed = 35
        hum:MoveTo(targetPos)
        if os.clock() - lastJump >= 2 then hum.Jump = true; lastJump = os.clock() end
        getgenv().noclip = true
        for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
    end
end

