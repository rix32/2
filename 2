-- [القسم 16] علامة التبويب: الإعدادات
-- ----------------------------------------
local SettingsTab = MainWindow:Tab({ Title = "الإعدادات", Icon = "settings", Locked = false })
local themeList = {}
for name in pairs(WindUI.Themes) do table.insert(themeList, name) end
table.sort(themeList)

SettingsTab:Dropdown({ Title = "الثيمات", Values = themeList, Value = "Dark", Callback = function(o) WindUI:SetTheme(o) end })
SettingsTab:Keybind({ Title = "اختصار الفتح", Value = "LeftControl", Callback = function(v) MainWindow:SetToggleKey(Enum.KeyCode[v]) end })
SettingsTab:Space()

local ConfigManager = MainWindow.ConfigManager
local currentConfigName = "default"
local configInput = SettingsTab:Input({ Title = "اسم الإعدادات", Value = currentConfigName, Callback = function(v) currentConfigName = v end })
local configDropdown = SettingsTab:Dropdown({ Title = "الإعدادات المحفوظة", Values = ConfigManager:AllConfigs(), Callback = function(v)
    currentConfigName = v
    configInput:Set(v)
end })

SettingsTab:Button({ Title = "حفظ", Callback = function()
    local cfg = ConfigManager:CreateConfig(currentConfigName)
    if cfg:Save() then configDropdown:Refresh(ConfigManager:AllConfigs()) end
end })
SettingsTab:Button({ Title = "تحميل", Callback = function()
    local cfg = ConfigManager:CreateConfig(currentConfigName)
    cfg:Load()
end })
SettingsTab:Button({ Title = "حذف", Callback = function()
    local cfg = ConfigManager:CreateConfig(currentConfigName)
    cfg:Delete()
    configDropdown:Refresh(ConfigManager:AllConfigs())
end })

